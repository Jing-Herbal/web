{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": "deploy-updated",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/img/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
